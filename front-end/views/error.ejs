<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Sock Shop</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; text-align: center; }
        header { background: #333; color: white; padding: 15px 20px; margin: -20px -20px 20px -20px; }
        nav a { color: white; margin-right: 15px; text-decoration: none; }
        .error-box { background: white; border-radius: 8px; padding: 30px; max-width: 500px; margin: 50px auto; }
    </style>
</head>
<body>
    <header>
        <h1>Sock Shop</h1>
        <nav>
            <a href="/">Home</a>
        </nav>
    </header>
    <div class="error-box">
        <h2>Something went wrong</h2>
        <p><%= message %></p>
        <a href="/">Go back to Home</a>
    </div>
</body>
</html>
