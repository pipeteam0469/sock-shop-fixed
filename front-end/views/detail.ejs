<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Detail - Sock Shop</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; }
        header { background: #333; color: white; padding: 15px 20px; margin: -20px -20px 20px -20px; }
        nav a { color: white; margin-right: 15px; text-decoration: none; }
        .product-detail { background: white; border-radius: 8px; padding: 20px; max-width: 600px; }
    </style>
</head>
<body>
    <header>
        <h1>Sock Shop</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/cart">Cart</a>
            <a href="/login">Login</a>
        </nav>
    </header>
    <div class="product-detail">
        <h2><%= product.name %></h2>
        <p class="price" style="color: #2ecc71; font-weight: bold; font-size: 1.3em;">$<%= product.price ? product.price.toFixed(2) : '0.00' %></p>
        <p><%= product.description || 'No description available.' %></p>
        <p><strong>Stock:</strong> <%= product.count || 0 %></p>
        <button>Add to Cart</button>
    </div>
</body>
</html>
